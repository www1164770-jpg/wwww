APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=5001
FLASK_SECRET_KEY=
SECRET_KEY=
JWT_SECRET_KEY=

# Browser origin and optional additional comma-separated CORS origins.
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# Optional absolute directory outside the repository. Leave empty to use
# backend/uploads/backgrounds, resolved from this source tree.
BACKGROUND_UPLOAD_ROOT=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nav_site

REDIS_URL=redis://localhost:6379/0
# Optional Flask-Limiter storage; blank uses REDIS_URL.
RATELIMIT_STORAGE_URI=
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=

# Optional proxy for outbound Hacker News requests.
OUTBOUND_PROXY_URL=

MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_TIMEOUT=15

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DEEPSEEK_API_KEY=

# Base URL used by backend/scripts/check_home_api.py.
BACKEND_API_BASE_URL=http://127.0.0.1:5000/api
