# Independent crawler infrastructure. CRAWLER_DATABASE_URL has no fallback:
# configure a dedicated zhihui_crawler database only when running crawler CLI.
CRAWLER_DATABASE_URL=
CRAWLER_ICON_ROOT=backend/data/crawler/icons
CRAWLER_LOG_ROOT=backend/data/crawler/logs
CRAWLER_WORKER_ID=
CRAWLER_LEASE_SECONDS=300
CRAWLER_MAX_ATTEMPTS=3
CRAWLER_NIGHTLY_TARGET=3000
CRAWLER_START_TIME=01:00
CRAWLER_STOP_TIME=05:00
CRAWLER_USER_AGENT=ZhiHuiNavigationBot/1.0
CRAWLER_GLOBAL_CONCURRENCY=5
CRAWLER_DOMAIN_DELAY_SECONDS=1
CRAWLER_CONNECT_TIMEOUT_SECONDS=5
CRAWLER_READ_TIMEOUT_SECONDS=10
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES_PER_ORIGIN=20
CRAWLER_MAX_LINKS_PER_PAGE=200
CRAWLER_MAX_URLS_PER_RUN=100
CRAWLER_ROBOTS_CACHE_SECONDS=86400
CRAWLER_DNS_CACHE_SECONDS=60
CRAWLER_MAX_SITEMAP_BYTES=5242880
CRAWLER_MAX_SITEMAP_URLS=1000
CRAWLER_MAX_SITEMAP_FILES=20
CRAWLER_MAX_SITEMAP_DEPTH=3
CRAWLER_MAX_FEED_ENTRIES=100
CRAWLER_MAX_RETRIES=3
CRAWLER_ANALYSIS_ENABLED=false
CRAWLER_ANALYZER_TYPE=rules
CRAWLER_ANALYSIS_PROVIDER=
CRAWLER_ANALYSIS_MODEL=
CRAWLER_ANALYSIS_MODEL_VERSION=
CRAWLER_ANALYSIS_TIMEOUT_SECONDS=30
CRAWLER_ANALYSIS_MAX_INPUT_CHARS=20000
CRAWLER_ANALYSIS_MAX_OUTPUT_CHARS=10000
CRAWLER_ANALYSIS_MAX_RETRIES=3
CRAWLER_ANALYSIS_TAXONOMY_VERSION=v1
CRAWLER_ANALYSIS_SCORING_VERSION=v1
CRAWLER_ANALYSIS_PROMPT_VERSION=v1
CRAWLER_ANALYSIS_SCHEMA_VERSION=v1
CRAWLER_ICON_FETCH_ENABLED=false
CRAWLER_ANALYSIS_CONFIDENCE_THRESHOLD=0.85
CRAWLER_ANALYSIS_RULE_VERSION=analysis-rules-v1
CRAWLER_RISK_RULE_VERSION=risk-rules-v1
CRAWLER_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate
CRAWLER_OLLAMA_MODEL=qwen2.5:3b
CRAWLER_OLLAMA_TIMEOUT_SECONDS=20
CRAWLER_ICON_MAX_BYTES=1048576
CRAWLER_ICON_MAX_PIXELS=16777216
CRAWLER_ICON_MAX_REDIRECTS=3
CRAWLER_NAV_SITE_SYNC_ENABLED=false
CRAWLER_NAV_SITE_DATABASE_URL=
CRAWLER_NAV_SITE_ALLOWED_DATABASE=
CRAWLER_PUBLISH_MAX_RETRIES=3
CRAWLER_PUBLISH_RETRY_BASE_SECONDS=5
CRAWLER_PUBLISH_PREVIEW_TTL_SECONDS=3600
